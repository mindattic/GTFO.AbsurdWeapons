<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>GTFO.AbsurdWeapons.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <!-- The mod's game-free code, compiled straight in: the mod itself needs the game's Il2Cpp
       assemblies, these files don't. -->
  <ItemGroup>
    <Compile Include="..\..\src\GTFO.AbsurdWeapons\Pure\*.cs" Link="Pure\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
