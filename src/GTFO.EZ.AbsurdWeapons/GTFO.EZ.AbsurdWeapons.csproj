<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
    Which mod manager profile to build against and deploy into - same layout as GTFO.EZ.
    Thunderstore Mod Manager stores profiles under
    "Thunderstore Mod Manager\DataFolder\<Game>\profiles\<Game> - <Profile>". If you're on the
    older r2modman app instead, override BepInEx directly, e.g.:
      dotnet build -p:BepInEx="%AppData%\r2modmanPlus-local\GTFO\profiles\Default\BepInEx"
    -->
    <GameName>GTFO</GameName>
    <Profile>Easy Mode DEV</Profile>

    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <DebugType>none</DebugType>
    <AssemblyName>GTFO.EZ.AbsurdWeapons</AssemblyName>
    <RootNamespace>GTFO.EZ.AbsurdWeapons</RootNamespace>

    <BepInEx>$(AppData)\Thunderstore Mod Manager\DataFolder\$(GameName)\profiles\$(GameName) - $(Profile)\BepInEx</BepInEx>
    <OutputPath>$(BepInEx)\plugins\GTFO.EZ.AbsurdWeapons\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <Target Name="PostBuild" BeforeTargets="PostBuildEvent">
    <Delete Files="$(OutputPath)$(AssemblyName).deps.json" />
  </Target>

  <ItemGroup>
    <Reference Include="$(BepInEx)\core\0Harmony.dll" Private="false" />
    <Reference Include="$(BepInEx)\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInEx)\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInEx)\core\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(BepInEx)\core\Il2CppInterop.Runtime.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(BepInEx)\interop\*.dll" Private="false" />
    <Reference Remove="$(BepInEx)\interop\netstandard.dll" />
  </ItemGroup>

  <ItemGroup>
    <!-- The package's icon and manifest go next to the DLL too, so the mod manager shows the mod's
         icon for this local install, the same as for one installed from Thunderstore. -->
    <None Include="..\..\package\icon.png" Link="icon.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\package\manifest.json" Link="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- GTFO-API: network messages so teammates see the seeker guns' projectiles. -->
    <Reference Include="$(BepInEx)\plugins\GTFO-API.dll" Private="false" />
  </ItemGroup>

  <!-- Code every GTFO.* mod compiles in, from the GTFO.EZ.Shared submodule (external/GTFO.EZ.Shared;
       the root README says how to fetch it). Only the files this mod uses are linked. -->
  <ItemGroup>
    <Compile Include="..\..\external\GTFO.EZ.Shared\SharedOwner.cs" Link="Shared\SharedOwner.cs" />
    <Compile Include="..\..\external\GTFO.EZ.Shared\InfiniteToggles.cs" Link="Shared\InfiniteToggles.cs" />
    <Compile Include="..\..\external\GTFO.EZ.Shared\MessageHelper.cs" Link="Shared\MessageHelper.cs" />
    <Compile Include="..\..\external\GTFO.EZ.Shared\RemoteEvents.cs" Link="Shared\RemoteEvents.cs" />
  </ItemGroup>

</Project>
